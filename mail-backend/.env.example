# Same Supabase project as the website. The service-role key stays only on this local computer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SITE_URL=http://localhost:3000

# SMTP credentials (for example, your existing Spring Boot SMTP provider).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Lilac
MAILER_API_KEY=change-this-to-a-long-random-secret
MAIL_BACKEND_PORT=3010

EMAIL_SUBJECT=Your Official Entry Pass - Lilac Live in Concert
# Variables: {{name}}, {{reference}}, {{email}}. Write a literal \n for a new line.
EMAIL_TEXT_TEMPLATE=Dear Attendee,\n\nThank you for registering for Lilac Live in Concert! 💜\n\nWe’re pleased to share your official entry pass for the event. Please find your seating pass attached to this email.\n\nImportant Entry Instructions:\n\n- Please keep your entry pass ready on your mobile device.\n- Present the QR code clearly at the entrance gate for verification.\n- This pass is valid for single admission only and is non-transferable.\n\nPlease ensure that your QR code is clearly visible when arriving at the entrance.\n\nWe look forward to welcoming you to an unforgettable musical experience!\n\nWarm regards,\nLilac Live in Concert Team 💜
SMTP_DELAY_MS=250
