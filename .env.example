# ============================================================================
# Lilac Official Web — environment variables
# Copy to .env.local (gitignored) and fill in. On Vercel, set the same keys in
# Project → Settings → Environment Variables. NEVER commit real values.
#
# Rule: anything without the NEXT_PUBLIC_ prefix stays server-only and is never
# shipped to the browser. Only the two NEXT_PUBLIC_ vars below are safe to expose.
# ============================================================================

# ---- Supabase -------------------------------------------------------------
# From: Supabase dashboard → Project Settings → API. Use the STAGING project's
# values in .env.local for now; swap to production values only on the prod deploy.

# Safe to expose — used by the browser client for the anon INSERT on `entries`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Bypasses Row Level Security. Used exclusively by API routes for
# all admin reads/writes, draws, exports, and public aggregate queries.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Email: Brevo (entry verification emails, free tier 300/day) ---------
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@yourdomain.example
BREVO_SENDER_NAME=Lilac

# ---- Email: Resend (winner confirmation emails, free tier 100/day) ------
# Kept separate from Brevo so verification volume can never block winner mail.
RESEND_API_KEY=your-resend-api-key
RESEND_SENDER_EMAIL=winners@yourdomain.example
RESEND_SENDER_NAME=Lilac

# Where automatic winner-email failure notifications are sent.
ADMIN_NOTIFY_EMAIL=admin@yourdomain.example

# ---- Bot protection: Cloudflare Turnstile -------------------------------
# Not provisioned yet. Until real keys are set, the entry route treats
# verification as a no-op in development only (never in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- App ---------------------------------------------------------------
# Canonical origin, used to build verification / winner links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Sentry (error monitoring, added in a later stage) -----------------
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
