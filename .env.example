# ============================================================================
# Lilac Official Web — environment variables (TEMPLATE ONLY)
#
# This file is committed and MUST NOT contain real secrets. Next.js never reads
# it. Copy it to .env.local (gitignored) and put real values there:
#     cp .env.example .env.local
# On Vercel, set the same keys in Project → Settings → Environment Variables.
#
# Rule: anything without the NEXT_PUBLIC_ prefix stays server-only and is never
# shipped to the browser. Only the NEXT_PUBLIC_ vars below are safe to expose.
# ============================================================================

# ---- Supabase -------------------------------------------------------------
# From: Supabase dashboard → Project Settings → API. Use the STAGING project's
# values in .env.local for now; swap to production values only on the prod deploy.

# Safe to expose — used by the browser client for the anon INSERT on `entries`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Bypasses Row Level Security. Used exclusively by API routes for
# all admin reads/writes, draws, exports, and public aggregate queries.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Email: Resend (all transactional email) ----------------------------
# One provider for verification, contact-form forwarding, winner confirmation,
# and admin alerts. Free tier: 3,000/month, 100/day. Requires a verified
# sending domain (Resend dashboard → Domains) before it will deliver to
# arbitrary recipients. Until a domain is verified, Resend only allows sending
# from onboarding@resend.dev to your own account email.
RESEND_API_KEY=your-resend-api-key
# onboarding@resend.dev = zero-setup test sender (delivers ONLY to your own Resend
# account email). For real use: no-reply@<your-verified-domain>.
RESEND_SENDER_EMAIL=onboarding@resend.dev
RESEND_SENDER_NAME=Lilac

# Where automatic winner-email failure notifications are sent.
ADMIN_NOTIFY_EMAIL=admin@yourdomain.example

# ---- Admin panel -----------------------------------------------------
# Sign in at /admin/login with this email + password. One operator, no account
# store. Nothing to set up in Supabase Auth.
ADMIN_EMAIL=admin@yourdomain.example
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ---- App ---------------------------------------------------------------
# Canonical origin, used to build winner links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
