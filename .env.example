# Copy this to .env.local and fill in real values. .env.local is gitignored;
# this file is the committed template — see lib/env.ts for how each var is used.

# Supabase project — Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used to build absolute links (ticket QR/check-in URLs,
# etc). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mailjet (free tier) — sends the e-ticket QR + reference on purchase
# approval, the winner notice when a draw runs, and contact-form forwarding.
# https://app.mailjet.com/account/apikeys
# Leave unset to run without email: each flow still succeeds, it just logs
# to /admin/audit instead of sending (see lib/email/mailjet.ts).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=Lilac

# Admin panel — the one full-admin login, and the secret that signs its
# session cookie. Generate a secret with `openssl rand -hex 32`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Ticket manager — optional second, more limited admin login (ticket review +
# check-in only, see lib/auth.ts). Leave unset and this login simply doesn't
# exist.
TICKET_MANAGER_EMAIL=
TICKET_MANAGER_PASSWORD=

# Signs the ad-watch session token. Optional — falls back to
# ADMIN_SESSION_SECRET if unset.
AD_SESSION_SECRET=

# Door-staff scanner — shared code that unlocks the check-in pages only.
CHECKIN_ACCESS_CODE=

# Signs the check-in session cookie. Optional — falls back to
# ADMIN_SESSION_SECRET if unset; set a separate value in production so a leak
# of one doesn't let an attacker forge the other's cookie.
CHECKIN_SESSION_SECRET=
